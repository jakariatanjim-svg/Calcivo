{
  "name": "calcivo",
  "version": "1.0.0",
  "private": true,
  "description": "Calcivo - a full screen calculator for Android with in-app updates.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:web && node scripts/dev-server.mjs",
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && cap sync android",
    "test": "npm run build:web && node --test",
    "apk": "bash scripts/build-apk.sh",
    "apk:debug": "BUILD_VARIANT=debug bash scripts/build-apk.sh",
    "apk:release": "BUILD_VARIANT=release bash scripts/build-apk.sh",
    "icons": "python3 assets/generate-icons.py",
    "android:open": "cap open android",
    "test:engine": "node --test tests/engine.test.mjs",
    "version": "node scripts/version.mjs",
    "version:next": "node scripts/version.mjs next"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.2"
  }
}
